# DDS configuration
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/udp_profile.xml

# Nav2 configuration
# Attention: MPPI controller is not compatible with **ROSbot 2 PRO**. Please use DWB or RPP controller.
# Nav2 requires a lidar publishing the `scan` topic, so CONFIGURATION must include one (see below).

CONTROLLER=mppi # options: 'dwb', 'mppi', 'rpp'
ROBOT_MODEL='' # options 'rosbot' or 'rosbot_xl'
ROBOT_NAMESPACE='' # optional namespace prefix for all topics/nodes
SLAM=True # if you have a map you can run navigation without SLAM

# Gazebo simulation configuration
# Only configurations that include a lidar work with Nav2:
#   rosbot    -> 'basic'
#   rosbot_xl -> 'autonomy', 'manipulation', 'manipulation_pro'
# (rosbot_xl 'basic'/'telepresence' have no lidar and will not work with Nav2.)
CONFIGURATION='' # e.g. 'basic' for rosbot, 'autonomy' for rosbot_xl
